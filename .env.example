# InsForge backend connection
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
#
# The VITE_ prefix is required for Vite (the bundler used by Angular CLI 17+)
# to expose the variable to `import.meta.env` at build time.
#
# Where to find these values:
#   - Log into your InsForge project dashboard
#   - Settings → API Keys shows the anon key
#   - The URL is your project's deployment URL

VITE_INSFORGE_BASE_URL=https://your-project.region.insforge.app
VITE_INSFORGE_ANON_KEY=ik_replace_with_your_real_anon_key
